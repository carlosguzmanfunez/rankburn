# RankBurn environment variables
#
# Copy to .env.local and fill in real values. No secret has a default: if one
# is missing, the feature that needs it stays disabled rather than insecure.
# Never commit .env.local.

# --- Database (REQUIRED) ----------------------------------------------------
# PostgreSQL connection string. Without it the app fails closed: no market, no
# moderation, no checkout. Managed options that work well here: Neon, Supabase,
# Vercel Postgres, Railway.
#   Local:   postgresql://postgres:postgres@localhost:5432/rankburn
#   Managed: usually requires ?sslmode=require
DATABASE_URL=

# Connections per instance. Keep small on serverless so many warm instances do
# not exhaust the database connection limit. Default: 5
DATABASE_POOL_MAX=5

# Set to "true" to enable POST /api/admin/seed, which loads the demo dataset.
# Leave unset in production so demo rows can never enter a live market.
RANKBURN_ALLOW_SEED=

# --- Site -------------------------------------------------------------------
# Public base URL. Used to build payment return/cancel URLs, so it must match
# the deployment exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Administrator access ---------------------------------------------------
# Secret used to sign the admin session cookie. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RANKBURN_SESSION_SECRET=

# Comma-separated allowlist of administrator emails.
RANKBURN_ADMIN_EMAILS=

# Shared administrator password. Replace with per-user credentials before
# production; this is a single-operator MVP measure, not a user system.
RANKBURN_ADMIN_PASSWORD=

# --- PayPal (checkout stays disabled until all three are set) ---------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Sandbox by default. Switch to https://api-m.paypal.com only after PayPal has
# confirmed the production business model in writing.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
