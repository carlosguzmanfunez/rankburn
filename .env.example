# RankBurn environment variables
#
# Copy to .env.local and fill in real values. No secret has a default: if one
# is missing, the feature that needs it stays disabled rather than insecure.
# Never commit .env.local.

# --- Database (REQUIRED) ----------------------------------------------------
# PostgreSQL connection string. Without it the app fails closed: no market, no
# moderation, no checkout. Managed options that work well here: Neon, Supabase,
# Vercel Postgres, Railway.
#   Local:   postgresql://postgres:postgres@localhost:5432/rankburn
#   Managed: usually requires ?sslmode=require
DATABASE_URL=

# Connections per instance. Keep small on serverless so many warm instances do
# not exhaust the database connection limit. Default: 5
DATABASE_POOL_MAX=5

# Set to "true" to enable POST /api/admin/seed, which loads the demo dataset.
# Leave unset in production so demo rows can never enter a live market.
RANKBURN_ALLOW_SEED=

# --- Site -------------------------------------------------------------------
# Public base URL. Used to build payment return/cancel URLs, so it must match
# the deployment exactly (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Administrator access ---------------------------------------------------
# Secret used to sign the admin session cookie. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs BOTH the administrator and the advertiser session cookies. The two are
# kept apart by a `scope` claim inside the signed payload that is re-checked on
# every read, so an admin cookie can never be replayed as an advertiser one.
# Without this value, sign-in is unavailable rather than open.
RANKBURN_SESSION_SECRET=

# Comma-separated allowlist of administrator emails.
RANKBURN_ADMIN_EMAILS=

# Shared administrator password. Replace with per-user credentials before
# production; this is a single-operator MVP measure, not a user system.
RANKBURN_ADMIN_PASSWORD=

# --- Scheduled jobs ---------------------------------------------------------
# Bearer token for POST /api/internal/expiry-scan, which enqueues the
# "10 minutes of budget left" warnings. Without it the endpoint fails closed
# (401) and the warnings never run, silently. Generate one the same way as the
# session secret.
RANKBURN_CRON_SECRET=

# --- Legends (historical recognition; never affects the Live Market) --------
# A finished run qualifies on ANY ONE of these sustained-position criteria.
# Merit is position held over time, not spending power: there is deliberately
# no minimum Burn Rate. Leave unset to use the product defaults shown.
FLIPPEAK_LEGENDS_MIN_MINUTES_GLOBAL_ONE=10
FLIPPEAK_LEGENDS_MIN_MINUTES_CATEGORY_ONE=20
FLIPPEAK_LEGENDS_MIN_MINUTES_TOP_THREE=60
FLIPPEAK_LEGENDS_TOP_TIER_RANK=3

# --- PayPal (checkout stays disabled until all three are set) ---------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Sandbox by default. Switch to https://api-m.paypal.com only after PayPal has
# confirmed the production business model in writing.
#
# Refunds use the same credentials: a payment whose run closed before the
# webhook arrived is returned to the payer automatically, so the credentials
# must have refund permission in whichever environment this points at.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
